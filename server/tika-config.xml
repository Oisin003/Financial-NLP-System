<?xml version="1.0" encoding="UTF-8"?>
<properties>
  <parsers>
    <parser class="org.apache.tika.parser.DefaultParser">
      <params>
        <param name="enableImageProcessing" type="bool">true</param>
      </params>
    </parser>
    <parser class="org.apache.tika.parser.pdf.PDFParser">
      <params>
        <!-- Default to no_ocr so Tika doesn't require Tesseract for every request.
             OCR is requested per-call via the X-Tika-PDFOcrStrategy header. -->
        <param name="ocrStrategy" type="string">no_ocr</param>
        <param name="extractInlineImages" type="bool">true</param>
      </params>
    </parser>
    <parser class="org.apache.tika.parser.ocr.TesseractOCRParser">
      <params>
        <!-- Paths injected by startTika.js at runtime -->
        <param name="language" type="string">eng</param>
      </params>
    </parser>
  </parsers>
</properties>
<!-- https://www.tutorialspoint.com/tika/tika_overview.htm -->